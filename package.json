{
  "name": "eazydata",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "main": "./opencode.mjs",
  "exports": {
    ".": "./opencode2.mjs"
  },
  "description": "eazydata provider plugin for Magpie: an OpenAI-compatible relay (eazydata.org) whose model list is read live from /v1/models and whose dollar balance is read from the billing routes",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "eazydata",
    "provider",
    "relay",
    "openai-compatible"
  ],
  "license": "MIT",
  "author": "zZ783",
  "homepage": "https://github.com/zZ783/eazydata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zZ783/eazydata.git"
  },
  "bugs": {
    "url": "https://github.com/zZ783/eazydata/issues"
  },
  "files": [
    "index.mjs",
    "opencode.mjs",
    "opencode2.mjs",
    "src/",
    "assets/",
    "test/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/all.mjs",
    "check": "node --check index.mjs && node --check src/index.mjs && node test/all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "name": "EazyData",
    "summary": {
      "en": "OpenAI-compatible relay on eazydata.org, with its model list read live from /v1/models and the account's dollar balance read from the relay's billing routes",
      "zh": "eazydata.org 上的 OpenAI 兼容中转，模型列表实时读取 /v1/models，账户余额读取中转站的 billing 接口"
    },
    "maxConcurrency": 8,
    "icon": "data:image/png;base64,"
  }
}
